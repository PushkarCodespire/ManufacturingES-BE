PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dynatech
DB_USER=dynatech
DB_PASS=your_db_password_here

# JWT
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_SECRET
JWT_EXPIRES_IN=8h

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# File Storage (PVC-backed disk storage)
UPLOAD_DIR=./uploads
UPLOAD_PUBLIC_PATH=/api/upload/image
UPLOAD_PUBLIC_URL=https://YOUR-DOMAIN.com/api/upload/image
MAX_FILE_SIZE=52428800

# SMTP Email (optional — needed for RFQ emails, notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Dynatech ONE <noreply@dynatech.com>

# Anthropic API (optional — only needed for AI features)
ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_API_KEY
