PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dynatech
DB_USER=dynatech
DB_PASS=your_db_password_here

# JWT
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_SECRET
JWT_EXPIRES_IN=8h

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Cloudinary (file & image uploads — get keys from cloudinary.com dashboard)
CLOUDINARY_CLOUD_NAME=REPLACE_WITH_CLOUD_NAME
CLOUDINARY_API_KEY=REPLACE_WITH_API_KEY
CLOUDINARY_API_SECRET=REPLACE_WITH_API_SECRET

# Anthropic API (optional — only needed for AI features)
ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_API_KEY
